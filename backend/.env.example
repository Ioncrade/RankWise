# Required only for generated answers; ingestion and retrieval work without these.
GROQ_API_KEY=
# Choose an active production model from https://console.groq.com/docs/models
GROQ_MODEL=qwen/qwen3.8-27b

# Generation routing: auto prefers Groq and falls back to Ollama on retryable failures.
RANKWISE_GENERATION_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.8:latest
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_API_KEY=

RANKWISE_DATA_DIR=./data
RANKWISE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RANKWISE_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RANKWISE_CANDIDATE_K=30
RANKWISE_CONTEXT_K=5
RANKWISE_CHUNK_SIZE=1200
RANKWISE_CHUNK_OVERLAP=150
RANKWISE_MAX_UPLOAD_BYTES=52428800
RANKWISE_OCR_ENABLED=true
# Tesseract language packs must be installed separately; combine codes with +.
RANKWISE_OCR_LANGUAGES=eng
RANKWISE_OCR_DPI=200
RANKWISE_OCR_MIN_CHARACTERS=24
RANKWISE_RENDER_MAX_DPI=300
